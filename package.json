{
    "name": "slick2d-ts",
    "version": "1.5.6",
    "description": "A TypeScript/WebGL parity layer for selected Slick2D APIs used by Java game ports.",
    "license": "BSD-3-Clause",
    "type": "module",
    "private": true,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/meatfighter/slick2d-ts.git"
    },
    "bugs": {
        "url": "https://github.com/meatfighter/slick2d-ts/issues"
    },
    "homepage": "https://github.com/meatfighter/slick2d-ts#readme",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./slick/*": {
            "types": "./dist/slick/*.d.ts",
            "import": "./dist/slick/*.js"
        },
        "./lwjgl/*": {
            "types": "./dist/lwjgl/*.d.ts",
            "import": "./dist/lwjgl/*.js"
        }
    },
    "files": [
        "dist",
        "COMPATIBILITY.md",
        "LICENSE",
        "NOTICE.md",
        "README.md"
    ],
    "scripts": {
        "build": "npm run clean && tsc -p tsconfig.json",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "lint": "eslint src --ext .ts",
        "test": "npm run build && node --test test/*.mjs",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "check:dist": "node scripts/check-dist-clean.mjs",
        "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run check:dist",
        "clean": "node scripts/clean-dist.mjs",
        "test:browser": "node scripts/run-browser-tests.mjs",
        "verify:browser": "npm run build && npm run test:browser"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "eslint": "^10.8.0",
        "prettier": "^3.9.6",
        "typescript": "^5.9.0",
        "typescript-eslint": "^8.69.0"
    }
}
