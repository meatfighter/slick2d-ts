{
    "name": "slick2d-ts",
    "version": "1.0.0",
    "description": "A TypeScript/WebGL parity layer for the Slick2D APIs used by the audited Java games.",
    "license": "GPL-3.0-only",
    "type": "module",
    "private": true,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./slick/*": {
            "types": "./dist/slick/*.d.ts",
            "import": "./dist/slick/*.js"
        },
        "./lwjgl/*": {
            "types": "./dist/lwjgl/*.d.ts",
            "import": "./dist/lwjgl/*.js"
        }
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "lint": "eslint src --ext .ts",
        "test": "npm run build && node --test test/*.mjs",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "eslint": "^10.8.0",
        "prettier": "^3.9.6",
        "typescript": "^5.9.0",
        "typescript-eslint": "^8.65.0"
    }
}
